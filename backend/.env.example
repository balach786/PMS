# ---------------------------------------------------------------------------
# BK Petrol Pump Management SaaS - Backend environment
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ---------------------------------------------------------------------------

# MongoDB connection string.
# Local:      mongodb://127.0.0.1:27017
# Atlas:      mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017

# Name of the SaaS master database (holds pumps / subscriptions / super admins)
MASTER_DB_NAME=petrol_saas_master

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=7d

# Port for the Express API
PORT=5000

# Frontend origin (CORS). Comma separated for multiple origins.
CLIENT_URL=http://localhost:5173

# Environment: development | production
NODE_ENV=development

# Rate limiting. Set RATE_LIMIT_DISABLED=true only for automated test runs.
RATE_LIMIT_DISABLED=false
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_REGISTER_MAX=25
RATE_LIMIT_API_MAX=5000
